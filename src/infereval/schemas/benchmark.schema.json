{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allen.is/infereval/schema/benchmark-1.0.json",
  "title": "infereval benchmark (beta)",
  "$defs": {
    "AnalystModel": {
      "additionalProperties": false,
      "description": "A human analyst :math:`a_j` whose verdicts appear in :math:`V_i`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "expertise_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expertise Description"
        },
        "panel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Panel"
        }
      },
      "required": [
        "id"
      ],
      "title": "AnalystModel",
      "type": "object"
    },
    "BearerModel": {
      "additionalProperties": false,
      "description": "JSON shape for a :class:`infereval.types.Bearer`.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "paraphrases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Paraphrases",
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "ordinal_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal Family"
        }
      },
      "required": [
        "expression"
      ],
      "title": "BearerModel",
      "type": "object"
    },
    "BenchmarkItem": {
      "additionalProperties": false,
      "description": "A single benchmark item: an implication paired with analyst verdicts.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "premises": {
          "items": {
            "type": "string"
          },
          "title": "Premises",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "type": "string"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "analyst_verdicts": {
          "items": {
            "$ref": "#/$defs/Verdict"
          },
          "title": "Analyst Verdicts",
          "type": "array"
        },
        "analyst_rationales": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-analyst, per-item rationales: the natural-language reason each analyst gave for their verdict on this item. Positionally aligned to analyst_verdicts \u2014 index j is analyst j's rationale, matching the benchmark's analysts declaration order. null (or absent) means 'this benchmark carries no rationale discipline.' A present-but-empty entry ('') means 'this analyst gave a verdict but recorded no reason on this item' \u2014 semantically distinct from null. When present, the length must equal len(benchmark.analysts).",
          "title": "Analyst Rationales"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "rsr_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/RSRTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "factor_levels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Factor Levels",
          "type": "object"
        },
        "construction_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstructionMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ladder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ladder"
        },
        "variation": {
          "anyOf": [
            {
              "enum": [
                "base",
                "strengthen",
                "contested",
                "defeat",
                "abstain_anchor",
                "monotonicity_step"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variation"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "placeholder": {
          "anyOf": [
            {
              "enum": [
                "good",
                "bad",
                "abstain",
                "contested"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "construction_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Construction Note"
        },
        "monotonicity_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonotonicityStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "premises",
        "conclusions",
        "analyst_verdicts"
      ],
      "title": "BenchmarkItem",
      "type": "object"
    },
    "ConstructionMetadata": {
      "additionalProperties": false,
      "description": "Per-item construction provenance for benchmark audit.\n\nRecords who authored an item, when, against what training-cutoff\nposture, and from what source materials. Phase 1.3 of the\nconstruct-validity infrastructure series, providing the data model\nfor requirements R5 (documented construction), R8 (held-out items),\nand R9 (training-data separation).\n\nContent is the analyst's responsibility \u2014 the framework validates\nstructure (Pydantic types, ``extra=\"forbid\"``) but does not enforce\nthat, e.g., ``authored_on`` actually post-dates a model's training\ncutoff. The point is to make the *presence* of these declarations\nauditable.",
      "properties": {
        "authored_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authored By"
        },
        "authored_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authored On"
        },
        "authored_blind_to_models": {
          "items": {
            "type": "string"
          },
          "title": "Authored Blind To Models",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "ConstructionMetadata",
      "type": "object"
    },
    "ContextBuilders": {
      "additionalProperties": false,
      "description": "Pair of context builders for :math:`\\mathrm{ctx}_\\Gamma` and :math:`\\mathrm{ctx}_\\Delta`.",
      "properties": {
        "premise": {
          "discriminator": {
            "mapping": {
              "plugin": "#/$defs/PluginContextBuilder",
              "template": "#/$defs/TemplateContextBuilder"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TemplateContextBuilder"
            },
            {
              "$ref": "#/$defs/PluginContextBuilder"
            }
          ],
          "title": "Premise"
        },
        "conclusion": {
          "discriminator": {
            "mapping": {
              "plugin": "#/$defs/PluginContextBuilder",
              "template": "#/$defs/TemplateContextBuilder"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TemplateContextBuilder"
            },
            {
              "$ref": "#/$defs/PluginContextBuilder"
            }
          ],
          "title": "Conclusion"
        }
      },
      "title": "ContextBuilders",
      "type": "object"
    },
    "CopresenceRule": {
      "additionalProperties": false,
      "description": "``@copresent`` saturation / well-formedness rule over ordinal families.\n\nDeclares that a set of :attr:`families` must co-occur: an item carrying a\ntier from any listed family must carry a tier from every listed family. This\nis a *well-formedness* rule on item construction, NOT an exclusion of any\ntier combination. With :attr:`exhaustivity` off (the default) the constraint\ncompiler emits only an admissibility rule and **no** sequents; turning it on\nadditionally makes exhaustivity itself testable (brief \u00a72/\u00a77).",
      "properties": {
        "families": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Families",
          "type": "array"
        },
        "exhaustivity": {
          "default": false,
          "title": "Exhaustivity",
          "type": "boolean"
        }
      },
      "required": [
        "families"
      ],
      "title": "CopresenceRule",
      "type": "object"
    },
    "EntailmentRule": {
      "additionalProperties": false,
      "description": "``@entails`` bearer-level entailment: ``antecedent`` present entails ``consequent``.",
      "properties": {
        "antecedent": {
          "title": "Antecedent",
          "type": "string"
        },
        "consequent": {
          "title": "Consequent",
          "type": "string"
        }
      },
      "required": [
        "antecedent",
        "consequent"
      ],
      "title": "EntailmentRule",
      "type": "object"
    },
    "FactorConstraints": {
      "additionalProperties": false,
      "description": "Constraints the benchmark validator should enforce on the factorial design.\n\nCurrently supports ``min_items_per_cell``: every cell of the *fully\ncrossed* design (cartesian product of all declared factor levels)\nmust contain at least this many items, where a cell is defined by\nthe per-factor level assignments in :attr:`BenchmarkItem.factor_levels`.\n\nPer *Closing the Construct-Validity Gap in infereval* (Phase 1.1)\naddressing requirement R7 (multiple items per condition) and\nsupporting R12 (per-condition decomposition).",
      "properties": {
        "min_items_per_cell": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Items Per Cell"
        }
      },
      "title": "FactorConstraints",
      "type": "object"
    },
    "MonotonicityStep": {
      "additionalProperties": false,
      "description": "Ordinal-family annotation for a ``monotonicity_step`` item (v0.5 schema).\n\nDeclares where the item sits on an ordinal ladder: the :attr:`family` walked,\nthe :attr:`tier` it occupies, that tier's 0-based :attr:`tier_index` in the\nfamily's declared order, and the :attr:`expected` monotonicity direction of\nendorsement as the tier rises. On a cross-family ladder, :attr:`fixed` names\nthe bearer id held constant in the other family. Consumed by the\nmonotonicity scorer (v0.17.1); never by the shape-blind measurement layer.",
      "properties": {
        "family": {
          "title": "Family",
          "type": "string"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "tier_index": {
          "title": "Tier Index",
          "type": "integer"
        },
        "expected": {
          "default": "non_decreasing",
          "enum": [
            "non_decreasing",
            "non_increasing"
          ],
          "title": "Expected",
          "type": "string"
        },
        "fixed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed"
        }
      },
      "required": [
        "family",
        "tier",
        "tier_index"
      ],
      "title": "MonotonicityStep",
      "type": "object"
    },
    "PluginContextBuilder": {
      "additionalProperties": false,
      "description": "A context builder specified by a dotted import path.\n\nThe plugin must resolve to a callable ``(Sequence[str]) -> str`` taking\nbearer expressions and returning the natural-language context.",
      "properties": {
        "kind": {
          "const": "plugin",
          "default": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin": {
          "title": "Plugin",
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "PluginContextBuilder",
      "type": "object"
    },
    "RSRTarget": {
      "additionalProperties": false,
      "description": "Target inference :math:`\\langle X, A \\rangle` for an RSR-targeted item.\n\nSee the paper's Remark on \"RSR-targeted benchmarks\".",
      "properties": {
        "X": {
          "items": {
            "type": "string"
          },
          "title": "X",
          "type": "array"
        },
        "A": {
          "items": {
            "type": "string"
          },
          "title": "A",
          "type": "array"
        }
      },
      "required": [
        "X",
        "A"
      ],
      "title": "RSRTarget",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A traceable provenance entry for a benchmark, bearer, or item.\n\nThe motivating use case is regulated-domain benchmarks (medical, legal,\nfinancial) where every non-trivial implication needs a citation to a\nguideline, statute, or peer-reviewed source. Recording these as\nstructured objects lets downstream tooling render bibliographies,\nvalidate DOIs, and connect items to the documents that justify them.\n\nOnly :attr:`citation` is required. The other fields populate when the\nrelevant identifier is known and remain ``None`` otherwise.\n\nAuthoring shorthand: a plain string in any ``references`` list is\nauto-promoted to a :class:`Reference` with the string as\n:attr:`citation` and everything else ``None``. See\n:func:`_promote_reference_shorthand`.",
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "citation"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Regularity": {
      "additionalProperties": false,
      "description": "``~regularity``: a tested-but-not-enforced defeasible regularity.\n\nDocuments a domain regularity that is *tested* (typically as a cross-family\nladder) rather than *enforced* \u2014 it earns no membership in the derived\nimplication frame. :attr:`test_item_ids` optionally names the items probing\nit.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "test_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Test Item Ids",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "Regularity",
      "type": "object"
    },
    "TemplateContextBuilder": {
      "additionalProperties": false,
      "description": "A context builder specified by an inline template string.\n\nThe template is a format string with a single ``{expressions}`` placeholder.\nBearer expressions are joined by ``joiner`` to fill it.",
      "properties": {
        "kind": {
          "const": "template",
          "default": "template",
          "title": "Kind",
          "type": "string"
        },
        "template": {
          "default": "{expressions}",
          "title": "Template",
          "type": "string"
        },
        "joiner": {
          "default": " and ",
          "title": "Joiner",
          "type": "string"
        }
      },
      "title": "TemplateContextBuilder",
      "type": "object"
    },
    "Verdict": {
      "description": "Endorsement verdict :math:`E_M(\\langle \\Gamma, \\Delta \\rangle)`.\n\nString-valued so JSON serialization yields ``\"good\"`` / ``\"bad\"`` / ``\"abstain\"``\ndirectly. The ``(str, Enum)`` pattern is used in place of\n:class:`enum.StrEnum` for Python 3.10 compatibility.",
      "enum": [
        "good",
        "bad",
        "abstain"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "VerificationPromptOverride": {
      "additionalProperties": false,
      "description": "Optional benchmark-level override of the framework's default verification prompt.\n\nAll four fields are optional in practice (``template`` is required by\nthe schema since it is the minimal thing an override needs to\ncontribute). When a field is ``None`` the framework default is used:\n\n- :attr:`system` ``None`` \u2192 :data:`infereval.prompts.DEFAULT_SYSTEM_PROMPT`.\n- :attr:`parse_regex` ``None`` \u2192 :data:`infereval.prompts.DEFAULT_PARSE_REGEX`.\n- :attr:`id` ``None`` \u2192 the caller-supplied ``override_id`` parameter to\n  :func:`infereval.prompts.resolve_verification_prompt`.\n\nAdding the ``system`` field makes the paraphrase-axis experiment\nfully JSON-drivable (no Python required to vary the verification prompt).",
      "properties": {
        "template": {
          "title": "Template",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "parse_regex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parse Regex"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "template"
      ],
      "title": "VerificationPromptOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A benchmark :math:`\\beta` over a bearer set, analyst panel, and items.\n\nSee the paper, Definition 4.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "bearers": {
      "additionalProperties": {
        "$ref": "#/$defs/BearerModel"
      },
      "title": "Bearers",
      "type": "object"
    },
    "analysts": {
      "items": {
        "$ref": "#/$defs/AnalystModel"
      },
      "minItems": 1,
      "title": "Analysts",
      "type": "array"
    },
    "context_builders": {
      "$ref": "#/$defs/ContextBuilders"
    },
    "verification_prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationPromptOverride"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BenchmarkItem"
      },
      "title": "Items",
      "type": "array"
    },
    "factors": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Factors",
      "type": "object"
    },
    "factor_constraints": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactorConstraints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "factor_kinds": {
      "additionalProperties": {
        "enum": [
          "substantive",
          "experimentally_controlled"
        ],
        "type": "string"
      },
      "title": "Factor Kinds",
      "type": "object"
    },
    "primary_panel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Panel"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "ordinal_families": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Ordinal Families",
      "type": "object"
    },
    "copresence_rules": {
      "items": {
        "$ref": "#/$defs/CopresenceRule"
      },
      "title": "Copresence Rules",
      "type": "array"
    },
    "entailment_rules": {
      "items": {
        "$ref": "#/$defs/EntailmentRule"
      },
      "title": "Entailment Rules",
      "type": "array"
    },
    "regularities": {
      "items": {
        "$ref": "#/$defs/Regularity"
      },
      "title": "Regularities",
      "type": "array"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "bearers",
    "analysts",
    "items"
  ],
  "type": "object"
}
